<?xml version="1.0" encoding="utf-8"?>
<!-- The dev build claims no web links: they always open in the stable app. To test a link in the dev build, start
     its LinkActivity directly: otto phone launch io.github.otto.dev --activity .LinkActivity --url <link>. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity android:name=".LinkActivity" tools:node="merge">
            <intent-filter tools:node="removeAll" />
        </activity>
    </application>
</manifest>
